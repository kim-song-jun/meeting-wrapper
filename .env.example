# MolRoom public browser configuration
#
# Copy this file to .env and replace only the angle-bracket placeholders.
# Every VITE_* value is compiled into the browser bundle. Never put a password,
# OAuth client secret, token, refresh material, or other private credential here.

# Deployment target: local | preview | production.
VITE_DEPLOYMENT=production

# Runtime data adapter for this Google-enabled build.
VITE_ADAPTER=google

# Public OAuth 2.0 Web application client ID (not a client secret).
VITE_GOOGLE_CLIENT_ID=<google-oauth-web-client-id>

# Hosted-domain hint for the Google account picker. Calendar permissions remain
# the authorization boundary.
VITE_ALLOWED_HD=<workspace-hosted-domain>
