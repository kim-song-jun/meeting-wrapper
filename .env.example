# molroom 환경변수
#
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
# 값이 비어 있으면 앱은 mock 어댑터로 동작한다 (화면 개발용).

# Google Cloud 프로젝트의 OAuth 2.0 클라이언트 ID (유형: 웹 애플리케이션)
# 동의 화면은 반드시 Internal(조직 내부용)로 설정할 것 — 구글 앱 심사가 면제된다.
VITE_GOOGLE_CLIENT_ID=

# 로그인 허용 도메인. 계정 선택 UI 를 좁히는 UX 힌트일 뿐 보안 장치가 아니다.
# 실제 접근 통제는 구글의 캘린더 권한이 한다 (설계 스펙 §2.3, §7).
VITE_ALLOWED_HD=molcube.com

# 데이터 어댑터: mock | google
# 스파이크 테스트(설계 스펙 §10)가 끝나기 전까지는 mock 을 쓴다.
VITE_ADAPTER=mock
